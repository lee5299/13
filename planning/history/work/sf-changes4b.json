    ],
    "attributes": {
      "architecture": {
        "개발역할연결": [
          "SpecFrame의 확정/제안/미검증이 구분된 전체 명세 → 호스트가 요구사항 ID를 기능·파일·검증 사례에 연결 → SynFrame의 기술 비교와 선택·실패에 따른 재판정.",
          "호스트가 C#/WPF 실제 프로젝트를 구현하고 빌드·실행 → computer-use는 반환된 실제 앱 창을 관찰·조작·재관찰 → 파일/상태와 계산·복원 검증 결과를 함께 Review에 반환.",
          "스킬은 개발 지침이다. 완성 프로그램의 실행에 SynFrame·SpecFrame·computer-use를 설치하거나 AI 서버에 접속할 필요가 있는 구조로 만들지 않는다."
        ],
        "백업연결": "앱이 저장된 자료/설정의 일관된 백업 입력을 준비한다. SQLite를 보관한다면 실행 중 DB파일을 무작정 복사하지 않고 BackupDatabase 같은 지원 경로로 사본을 만든다. 앱이 로컬 restic 프로세스를 호출해 snapshot ID와 종료코드/JSON·오류를 읽고 성공·부분실패·실패를 구별한다. 기본은 비관리자 파일 백업이며 VSS는 선택적 별도 권한/환경 검증 대상으로 둔다. 복원은 새 빈 위치로 꺼내 원본과 확인 후 명시 적용한다. 잠긴 파일·장치분리·용량부족은 기존 복구본을 유지한다.",
        "자동화범위": "내장 파일/클립보드/외부프로그램 열기와 기존 백업엔진을 재사용하고, 업무 고유 ID·상태대조·편집충돌·주기·업무부담·제출물 연결은 앱 고유 동작으로 구현한다. 백업 앱을 매번 수동 실행하도록 떠넘기지 않는다. computer-use가 금지한 Win키 단축키 검사는 이 스킬로 자동 수행한다고 약속하지 않는다. 해당 인수 동작은 허용된 별도 테스트 수단 또는 사용자 확인으로 처리하며 금지를 우회하지 않는다.",
        "제품저장제안": [
          "요청마다 YYMMDD_작업명_요청내용 폴더. 이름/위치와 별개인 업무 고유 ID를 관리하고 원래 주기·최초 요청시각을 보존한다. 메타정보의 고유 ID까지 복제된 폴더는 충돌로 감지하고 조용히 합치지 않는다.",
          "원문·본인 이해·실행명령/오류 기록의 텍스트와 실제 캡처/결과물은 작업폴더에 보존한다. 어떤 필드는 텍스트가 정본이고 어떤 필드는 관리 메타정보가 정본인지 개발설계서에서 단일 소유 표로 고정한다. SQLite에는 조회용 색인을 두고 같은 내용을 두 원본에서 독립 수정하지 않는다.",
          "SQLite 색인은 정본 자료로 다시 만들 수 있게 설계한다. 색인에만 남는 요청일·유형·이름규칙·설정이 없도록 복원 범위를 확인한다. 첨부 문서 본문은 검색·분류를 위해 읽지 않는다.",
          "파일 변경 알림은 대조가 필요한 신호로 취급한다. 시작·재연결·감지오류 뒤 폴더와 고유 ID를 대조하고 완료/복귀를 중복 반영하지 않는다. 실제 이동시각을 모르면 감지일로 꾸며 쓰지 않고 완료일 확인 필요를 유지한다.",
          "기록 저장은 임시파일·교체 전 보존과 버전 대조를 사용하고 양쪽 편집이 있으면 양쪽 내용을 보존한다. 파일 교체와 메타정보/폴더 이동이 동시에 성공한다고 가정하지 않는다. 작업 의도와 실제 위치를 남겨 중단 후 대조·재시도한다.",
          "바탕화면 전용 창과 일반 상세/완료 창을 분리하고, 기록 최대화는 읽기 편한 크기로 최소30줄·통상30~50줄을 실제 배율에서 확인한다."
        ]
      },
      "decision_rationale": {
        "WPF우선이유": "이번 목적은 Windows 개인용 폴더·텍스트 중심 앱이며 특수 바탕화면 창이 중요하다. 공식적으로 명시된 투명/테두리 없는 WPF 창과 일반 창을 첫 기술검증에 사용한다. 일반적인 신규 Windows 앱에 대한 WinUI 권장 자체를 부정하지 않으며 특수 동작이 보장된 것으로 확대하지 않는다.",
        "간단구성과비교": "폴더와 메모장만 사용하면 기록은 남지만 주/월 여유·기간검색·반복/제출물 연결·자동대조를 제공하지 못한다. 화면만 구현하면 원본/동시수정/재실행/복원 목적을 놓칠 수 있다. SQLite는 검색 역할, restic은 별도 버전복원 역할이므로 서로를 대체하지 않는다. 초기 시제품은 computer-use와 코드/파일검사로 확인하고 반복 UI 배치검사는 안정된 화면이 생긴 뒤 조건부 추가한다.",
        "대안": [
          {
            "구성": "WinUI 3 + OpenAI winui-app",
