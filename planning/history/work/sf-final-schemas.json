{
  "ReviewRecord": {
    "schema_version": 2,
    "contract_version": "3.2",
    "entity": "ReviewRecord",
    "fields": {
      "id": "str",
      "type": "ReviewRecord",
      "candidate_ref": "dict",
      "goal_ref": "dict",
      "snapshot": "list",
      "checks": "dict",
      "unresolved_items": "list"
    },
    "core_owned_fields": [
      "created_at",
      "revision",
      "schema_version",
      "source_run_id",
      "updated_at"
    ],
    "optional_fields": {
      "extensions": "dict",
      "dependency_refs": "list"
    },
    "enums": {},
    "structures": {
      "ReviewRecord.checks.*": {
        "status": "PASS|FAIL|UNKNOWN",
        "rationale": "str",
        "evidence_refs": "list:EvidenceRecord ref"
      },
      "ReviewRecord.extensions.capability_conditions.*": {
        "status": "PASS|FAIL|UNKNOWN",
        "rationale": "str",
        "evidence_refs": "list:EvidenceRecord ref",
        "understanding_basis": "nonempty list:scoped host ability/consumption assessment"
      },
      "ReviewRecord.extensions.capability_conditions.*.understanding_basis[]": {
        "criterion_ids": "nonempty list:current Capability criterion ID",
        "ability": "nonempty str:discrimination needed for this outcome",
        "scope": "nonempty str:purpose/environment/conditions",
        "task_requirements": "list:{task_ref:current LearningTask ref,requirement_ids:nonempty list:ability ID}; empty for grounded direct reuse",
        "evidence_refs": "nonempty list:current verified EvidenceRecord ref",
        "consumer_refs": "nonempty list:current actual consumer ref",
        "rationale": "nonempty str:actual sufficiency and consumption grounds, not generated by core"
      },
      "ReviewRecord.extensions.independent_followups": "dict keyed by current task ID, not list",
      "ReviewRecord.extensions.independent_followups.*": {
        "task_ref": "ref",
        "status": "CONTINUE|DEFER|NO_CURRENT_EFFECT",
        "decision_impact": "str",
        "rationale": "str",
        "evidence_refs": "list:EvidenceRecord ref",
        "requeue_condition": "str"
      }
    },
    "reference": {
      "id": "str",
      "revision": "positive int"
    },
    "scope": "Serialization contract only; no generated judgments or success defaults"
  },
  "SolutionPackage": {
    "schema_version": 2,
    "contract_version": "3.2",
    "entity": "SolutionPackage",
    "fields": {
      "id": "str",
      "type": "SolutionPackage",
      "candidate_ref": "dict",
      "review_ref": "dict",
      "contents": "dict",
      "completion_scope": "str",
      "artifact_refs": "list",
      "validation_refs": "list",
      "uncertainties": "list"
    },
    "core_owned_fields": [
      "created_at",
      "revision",
      "schema_version",
      "source_run_id",
      "updated_at"
    ],
    "optional_fields": {
      "extensions": "dict",
      "dependency_refs": "list"
    },
    "enums": {},
    "structures": {
      "SolutionPackage.contents": {
        "Architecture": "host-authored value",
        "Constraints": "host-authored value",
        "DecisionRationale": "host-authored value",
        "Goal": "host-authored value",
        "ImplementationPlan": "host-authored value",
        "Provenance": "host-authored value",
        "RecommendedSolution": "host-authored value",
        "RequiredKnowledge": "host-authored value",
        "SelectedAssets": "host-authored value",
        "Uncertainties": "host-authored value"
      },
      "SolutionPackage.validation_refs": "list:EvidenceRecord ref, not ReviewRecord refs",
      "SolutionPackage.uncertainties[]": {
        "description": "str",
        "important": "host-authored bool",
        "rationale": "actual impact/scope grounds for minor uncertainty at completion",
        "evidence_refs": "list:EvidenceRecord ref"
      }
    },
    "reference": {
      "id": "str",
      "revision": "positive int"
    },
    "scope": "Serialization contract only; no generated judgments or success defaults"
  }
}